{
  "name": "private-connect",
  "version": "0.7.4",
  "description": "Access private services by name from anywhere. No VPN setup, no firewall rules. Open source alternative to ngrok and Tailscale for service-level connectivity.",
  "bin": {
    "private-connect": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w"
  },
  "keywords": [
    "vpn-alternative",
    "ngrok-alternative",
    "tailscale-alternative",
    "secure-tunneling",
    "private-services",
    "service-connectivity",
    "zero-trust",
    "networking",
    "developer-tools",
    "cli-tool",
    "tunnel",
    "connectivity",
    "ssh-tunnel-alternative",
    "firewall-bypass",
    "service-mesh",
    "private-connect"
  ],
  "license": "FSL-1.1-MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/treadiehq/private-connect.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
