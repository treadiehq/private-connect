# Hub URL - the API server URL
# Users can override with --hub flag or by setting this env var
CONNECT_HUB_URL="http://localhost:3001"

# API key or agent token for non-interactive auth (CI/CD, scripts)
# PRIVATECONNECT_TOKEN=

# Allow insecure (non-TLS) hub connections (local dev only)
# CONNECT_ALLOW_INSECURE=true
