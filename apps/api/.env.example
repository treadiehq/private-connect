# Database connection
DATABASE_URL="postgresql://privateconnect:privateconnect@localhost:5432/privateconnect"

# API server port (optional, default: 3001)
PORT=3001

# ============================================
# Production settings (optional for local dev)
# ============================================

# Set to "production" to enable real email sending
NODE_ENV=development

# Resend API key for email auth (get one at https://resend.com)
RESEND_API_KEY=

# Email sender address (must be verified in Resend)
EMAIL_FROM="Private Connect <noreply@yourdomain.com>"

# Public URL for magic links
APP_URL="https://yourdomain.com"

# ============================================
# Ask LLM settings (for /ask page)
# ============================================
# Provider: openai, anthropic, or ollama
ASK_LLM_PROVIDER=
# Model name (e.g. gpt-4o-mini, claude-3-haiku-20240307, llama3)
ASK_LLM_MODEL=
# API key (required for openai/anthropic)
ASK_LLM_API_KEY=
# Ollama URL (optional, default: http://localhost:11434)
ASK_LLM_OLLAMA_URL=
